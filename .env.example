# ─────────────────────────────────────────────────────────────
# Variables d'environnement — Code de la Route Chatbot
# Copiez ce fichier en .env et remplissez les valeurs.
# ─────────────────────────────────────────────────────────────

# Clé API Groq (LLM Llama 3.3 70B)
# Obtenez-en une gratuitement sur https://console.groq.com
GROQ_API_KEY=votre_cle_groq_ici

# Clé secrète JWT — générez une chaîne aléatoire longue (ex: openssl rand -hex 32)
SECRET_KEY=votre_cle_secrete_tres_longue_ici

# Base de données
# En local : laissez vide ou SQLite est utilisé automatiquement
# Sur Render : collez l'URL PostgreSQL fournie par Render
# DATABASE_URL=postgresql://user:password@host:5432/dbname
